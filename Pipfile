[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

# Боевые зависимости закреплены точными версиями намеренно. С "*" установка
# любой dev-зависимости пересобирает замок целиком и молча поднимает версии
# рабочих пакетов — так `pipenv install --dev` в этой ветке однажды подняло
# cryptography, sqlalchemy и ещё семнадцать пакетов. Приложение —
# ежедневный рабочий инструмент; обновление версий должно быть отдельным
# осознанным шагом, а не побочным эффектом.
[packages]
pyrogram = "==2.0.106"
tgcrypto = "==1.2.5"
sqlalchemy = {extras = ["asyncio"], version = "==2.0.49"}
aiosqlite = "==0.22.1"
alembic = "==1.18.4"
greenlet = "==3.4.0"
httpx = "==0.28.1"
tzdata = "==2026.2"
numpy = "==2.4.4"
pywebview = "==6.2.1"
keyring = "==25.7.0"
cryptography = "==47.0.0"
beautifulsoup4 = "==4.15.0"
pypdf = "==6.16.2"
python-docx = "==1.2.0"
anthropic = "==1.12.1"
# Готовое колесо под процессор: на PyPI только исходники, их сборка требует компилятора C++.
llama-cpp-python = {file = "https://github.com/abetlen/llama-cpp-python/releases/download/v0.3.19/llama_cpp_python-0.3.19-cp313-cp313-win_amd64.whl"}
playwright = "==1.63.0"
# FastMCP, на котором стоит MCP-сервер агента, в ветке 2.x переименован с другим API.
mcp = "==1.30.0"
uvicorn = "==0.54.0"

# mutmut убран: 3.7.0 на Windows отказывается запускаться вообще
# («please use the WSL» ещё до разбора аргументов), 2.4.5 не работает на
# этой связке. Замена — tools/mutate.py. Зависимость, которую нельзя
# запустить, — ловушка для следующего человека.
[dev-packages]
pytest = "*"
pytest-asyncio = "*"
ruff = "*"

[requires]
python_version = "3.13"
