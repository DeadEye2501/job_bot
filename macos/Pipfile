[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

# Зависимости мак-сборки. Список повторяет корневой `Pipfile`: тот собирает
# Windows-exe, и маркеры платформы в нём потребовали бы пересборки его замка,
# а пересборка сдвинула бы незакреплённые транзитивные версии Windows.
# Расходятся три места: llama-cpp-python ставится из исходников с Metal, а
# Quartz и Cocoa из pyobjc зовут мак-двойники напрямую.
[packages]
pyrogram = "==2.0.106"
tgcrypto = "==1.2.5"
sqlalchemy = {extras = ["asyncio"], version = "==2.0.49"}
aiosqlite = "==0.22.1"
alembic = "==1.18.4"
greenlet = "==3.4.0"
httpx = "==0.28.1"
tzdata = "==2026.2"
numpy = "==2.4.4"
pywebview = "==6.2.1"
keyring = "==25.7.0"
cryptography = "==47.0.0"
beautifulsoup4 = "==4.15.0"
pypdf = "==6.16.2"
python-docx = "==1.2.0"
anthropic = "==1.12.1"
# Колеса под arm64 нет: собирается из исходников, `CMAKE_ARGS="-DGGML_METAL=on"`.
llama-cpp-python = "==0.3.19"
playwright = "==1.63.0"
mcp = "==1.30.0"
uvicorn = "==0.54.0"
pyobjc-framework-Quartz = "==12.2.2"
pyobjc-framework-Cocoa = "==12.2.2"

[dev-packages]
pytest = "*"
pytest-asyncio = "*"
ruff = "*"
pyinstaller = "*"

[requires]
python_version = "3.13"
